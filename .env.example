# Anticipa local configuration — copy to `.env` and fill in values. Never commit `.env` (ADR-035).
# Synthetic data only (ADR-003). See Docs/API_ACCESS_CHECKLIST.md for where each value comes from.

# --- Anthropic Claude API (Console API key; billed separately from Claude Max — ADR-024) ---
ANTHROPIC_API_KEY=replace-me

# --- Nebius Token Factory (OpenAI-compatible endpoint, verified 2026-11-06) ---
NEBIUS_API_KEY=replace-me
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- PostgreSQL + pgvector (docker compose service `postgres`) ---
POSTGRES_USER=anticipa
POSTGRES_PASSWORD=anticipa-dev-only
POSTGRES_DB=anticipa
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://anticipa:anticipa-dev-only@localhost:5432/anticipa

# --- HAPI FHIR R4 (docker compose service `hapi`, no credentials) ---
HAPI_FHIR_BASE_URL=http://localhost:8090/fhir

# --- Terminology ---
# RxNav is public (no key; NLM limit 20 requests/second per IP).
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST
# WHO ICD-11: local container needs no credentials; cloud API needs OAuth2 client credentials
# from https://icd.who.int/icdapi (leave blank to use the local container).
ICD11_BASE_URL=http://localhost:8095
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=

# --- Supabase (Auth + hosted Postgres for the deployed demo; ADR-056/057/058) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: browser-safe by design (also used by the frontend).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Secret key: server-side only (Admin API for `anticipa seed-users`). Never in frontend code.
SUPABASE_SECRET_KEY=sb_secret_replace-me
# Session-pooler URL (IPv4; supports prepared statements). Dashboard -> Connect -> Session pooler.
SUPABASE_DB_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=require
# Optional: Alembic target if different from DATABASE_URL (e.g. SUPABASE_DB_URL for cloud migrations).
MIGRATION_DATABASE_URL=

# --- Deployment (operator machine only; never deployed into services) ---
# Render API key: Dashboard -> Account Settings -> API Keys
RENDER_API_KEY=

# --- Application ---
ANTICIPA_ENV=local
# Used only by `anticipa seed-users`: the password of the privileged demo users (admin, coordinator, reviewer,
# system admin). Never share it.
ANTICIPA_DEMO_PASSWORD=
# Password of the shareable read-only judge login (anticipa.judge@example.com). MUST differ from the one above:
# the demo emails are public, so a shared password would let a judge sign in as the system admin.
ANTICIPA_JUDGE_PASSWORD=
# Model Router spend guard (UTC day).
ANTICIPA_AI_DAILY_BUDGET_USD=5.00
# Hard cap for one extraction run (set per run; leave empty for no run cap).
ANTICIPA_AI_RUN_BUDGET_USD=
# Nebius is opt-in (embeddings, semantic search). 1 = enabled.
ANTICIPA_ENABLE_NEBIUS=0
# Role given to Google sign-ins that have no assigned role ("" disables; only "observer" allowed).
ANTICIPA_GOOGLE_DEFAULT_ROLE=observer
# Where document text is read from: local (default) or supabase (cloud judging environment).
ANTICIPA_DOCUMENT_STORE=local
# Ask Anticipa limits.
ANTICIPA_ASK_DAILY_BUDGET_USD=2.00
ANTICIPA_ASK_RATE_PER_HOUR=20
ANTICIPA_ASK_RATE_PER_DAY=200
# Resident conversation (ADR-071): daily cost cap for its model replies and per-user messages per hour
ANTICIPA_CONVERSE_DAILY_BUDGET_USD=1.00
ANTICIPA_CONVERSE_RATE_PER_HOUR=60

# --- Frontend (frontend/.env.local, see frontend/.env.example) ---
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, ANTICIPA_API_ORIGIN
