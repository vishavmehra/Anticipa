<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;System context&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Who uses Anticipa and which outside services it depends on. Residents are synthetic and every message is simulated." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_people" value="PEOPLE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="590" as="geometry"/></mxCell>
<mxCell id="p0" value="&lt;b&gt;Population administrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Runs population analytics, guidelines, jobs and consent entries&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_people"><mxGeometry x="16" y="40" width="288" height="70" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;Care coordinator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Works assigned care gap cases, outreach and escalations&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_people"><mxGeometry x="16" y="130" width="288" height="70" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Clinical reviewer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Reviews evidence, approves guidelines, verifies completion&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_people"><mxGeometry x="16" y="220" width="288" height="70" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;System administrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Operates jobs, integrations, capacity and configuration&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_people"><mxGeometry x="16" y="310" width="288" height="70" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;Observer (judges)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Read only. Google sign-in defaults to this role&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_people"><mxGeometry x="16" y="400" width="288" height="70" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;Resident (simulated)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Receives simulated outreach and replies in English, Hindi or Arabic&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_people"><mxGeometry x="16" y="490" width="288" height="70" as="geometry"/></mxCell>
<mxCell id="core" value="&lt;b&gt;Anticipa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#E8E2FF;font-weight:normal&quot;&gt;Command Center (Next.js) and API (FastAPI modular monolith) with a background worker.&lt;br&gt;&lt;br&gt;READ, DECIDE, PLAN, ACT, CLOSE THE LOOP.&lt;br&gt;Deterministic rules decide eligibility. AI reads and communicates. Not a diagnostic system.&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#4B2FC4;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=22;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="520" y="200" width="420" height="210" as="geometry"/></mxCell>
<mxCell id="g_host" value="HOSTING (CLOUD JUDGING ENVIRONMENT)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="420" height="230" as="geometry"/></mxCell>
<mxCell id="vercel" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Next.js web app. Rewrites /api to the API&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_host"><mxGeometry x="16" y="45" width="120" height="120" as="geometry"/></mxCell>
<mxCell id="render" value="&lt;b&gt;Render&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;FastAPI API and worker, one Docker image&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_host"><mxGeometry x="146" y="45" width="120" height="120" as="geometry"/></mxCell>
<mxCell id="supa" value="&lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;PostgreSQL with pgvector, and Auth&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_host"><mxGeometry x="276" y="45" width="130" height="120" as="geometry"/></mxCell>
<mxCell id="hostnote" value="The full dataset and the live demo run locally with Docker Postgres. The cloud holds a small judging subset." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_host"><mxGeometry x="16" y="175" width="390" height="44" as="geometry"/></mxCell>
<mxCell id="g_ai" value="AI PROVIDERS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="340" height="250" as="geometry"/></mxCell>
<mxCell id="claude" value="&lt;b&gt;Anthropic Claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Haiku 5.5 for extraction, conversation and Ask. Sonnet 5.5 only for escalated documents&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_ai"><mxGeometry x="16" y="40" width="308" height="92" as="geometry"/></mxCell>
<mxCell id="nebius" value="&lt;b&gt;Nebius Token Factory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Opt-in embeddings only (Qwen3-Embedding-8B, 1,024 dimensions). Off by default&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="g_ai"><mxGeometry x="16" y="146" width="308" height="90" as="geometry"/></mxCell>
<mxCell id="g_data" value="HEALTH DATA" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="340" height="270" as="geometry"/></mxCell>
<mxCell id="synthea" value="&lt;b&gt;MITRE Synthea&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Generates synthetic patients as FHIR R4&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_data"><mxGeometry x="16" y="40" width="308" height="62" as="geometry"/></mxCell>
<mxCell id="hapi" value="&lt;b&gt;HAPI FHIR server (R4)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Local Docker. Demo cohort and write-back resources&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_data"><mxGeometry x="16" y="114" width="308" height="62" as="geometry"/></mxCell>
<mxCell id="clinic" value="&lt;b&gt;Clinics and capacity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Simulated clinics, services and appointment slots&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_data"><mxGeometry x="16" y="188" width="308" height="62" as="geometry"/></mxCell>
