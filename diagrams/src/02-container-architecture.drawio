<mxCell id="m_an" value="&lt;b&gt;analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Snapshot, Command Center, funnel, geography, impact&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_ins"><mxGeometry x="14" y="40" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="m_as" value="&lt;b&gt;ask&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Ask Anticipa: read only tools, grounding check&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_ins"><mxGeometry x="204" y="40" width="180" height="120" as="geometry"/></mxCell>
<mxCell id="m_ev2" value="&lt;b&gt;evaluation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Isolated. The only module that reads ground truth&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_ins"><mxGeometry x="394" y="40" width="188" height="120" as="geometry"/></mxCell>
<mxCell id="flow" value="Stage order follows READ, DECIDE, PLAN, ACT, CLOSE. Modules call each other through service functions, never through another module's tables." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_api"><mxGeometry x="16" y="528" width="1010" height="20" as="geometry"/></mxCell>
<mxCell id="claude" value="&lt;b&gt;Anthropic Claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Haiku 5.5, Sonnet 5.5&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1130" y="290" width="270" height="56" as="geometry"/></mxCell>
<mxCell id="nebius" value="&lt;b&gt;Nebius Token Factory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Opt-in embeddings only&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1130" y="358" width="270" height="56" as="geometry"/></mxCell>
<mxCell id="pg" value="&lt;b&gt;PostgreSQL 17 + pgvector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Schema anticipa, RLS on every table, job queue, analytics snapshots&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1130" y="440" width="270" height="108" as="geometry"/></mxCell>
<mxCell id="files" value="&lt;b&gt;Local files (data/)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Raw NDJSON.gz batches, document store&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="1130" y="562" width="270" height="56" as="geometry"/></mxCell>
