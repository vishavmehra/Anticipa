<mxCell id="b1" value="&lt;b&gt;Audit trail&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Every automated action writes an append only audit event. The database rejects updates and deletes.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="42" y="660" width="440" height="74" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;Synthetic and simulated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Every patient derived row is marked synthetic or simulated by a schema check. A real record cannot be stored.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="660" width="440" height="74" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;b&gt;Humans stay in the loop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Evidence review queue, clinical review outcomes, escalation and second person verification.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="958" y="660" width="440" height="74" as="geometry"/></mxCell>
