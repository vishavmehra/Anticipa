<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Synthetic data pipeline&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Reproducible, resumable and idempotent. Facts are planted before text is written, and ground truth is kept apart from the pipeline." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_a" value="1  GENERATE AND LOAD" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="1360" height="200" as="geometry"/></mxCell>
<mxCell id="a0" value="&lt;b&gt;Seeded batches&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Dataset syn-DATE-sSEED. Batch seed is base seed plus index. Resumable&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="16" y="40" width="168" height="138" as="geometry"/></mxCell>
<mxCell id="a1" value="&lt;b&gt;MITRE Synthea&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;6 workers. FHIR R4 bulk NDJSON per batch&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="208" y="40" width="168" height="138" as="geometry"/></mxCell>
<mxCell id="a2" value="&lt;b&gt;Raw NDJSON.gz&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Kept compressed per batch on disk for provenance&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="400" y="40" width="168" height="138" as="geometry"/></mxCell>
<mxCell id="a3" value="&lt;b&gt;Streaming normaliser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Condition, Procedure, Observation, Immunization, MedicationRequest, DiagnosticReport, Encounter&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="592" y="40" width="168" height="138" as="geometry"/></mxCell>
<mxCell id="a4" value="&lt;b&gt;Storage profile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;full for residents 1 to 100,000. rules for later residents: demographics, family edges, rule codes&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="784" y="40" width="168" height="138" as="geometry"/></mxCell>
<mxCell id="a5" value="&lt;b&gt;Bulk load&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;COPY, ON CONFLICT DO NOTHING. UUIDv5 ids make re-ingestion safe&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="976" y="40" width="168" height="138" as="geometry"/></mxCell>
<mxCell id="a6" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;residents, clinical_records&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_a"><mxGeometry x="1168" y="40" width="168" height="138" as="geometry"/></mxCell>
