<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g_b" value="2  ASSIGN GEOGRAPHY AND BUILD FAMILIES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1360" height="170" as="geometry"/></mxCell>
<mxCell id="b0" value="&lt;b&gt;District and language&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Deterministic hash of the resident id. Ten pilot districts and three languages&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_b"><mxGeometry x="16" y="40" width="300" height="110" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;Family linker&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Seeded, per block of 10,000 residents. Parents, siblings, children, spouse, grandparents&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_b"><mxGeometry x="352" y="40" width="330" height="110" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;family_edges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Both directions stored, with provenance&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_b"><mxGeometry x="718" y="40" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;b&gt;Family ground truth&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Written beside the database rows, in per block shards. Only evaluation reads it&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="g_b"><mxGeometry x="994" y="40" width="350" height="110" as="geometry"/></mxCell>
<mxCell id="_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="557" y="500"/><mxPoint x="1209" y="500"/></Array></mxGeometry></mxCell>
<mxCell id="g_c" value="3  GENERATE DOCUMENTS WITH PLANTED GROUND TRUTH (AI COHORT OF 10,000 RESIDENTS)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="542" width="1360" height="190" as="geometry"/></mxCell>
<mxCell id="c0" value="&lt;b&gt;Plan scenarios&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Per resident: positive, negated, wrong relative, wrong age, completed, conflicting, ambiguous&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_c"><mxGeometry x="16" y="42" width="244" height="126" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;Plant facts first&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Every statement carries its label before any text exists&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_c"><mxGeometry x="284" y="42" width="244" height="126" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Render text&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Templated documents in English, Hindi and Arabic&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_c"><mxGeometry x="552" y="42" width="244" height="126" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Document store&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Files plus a documents table with a content hash&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_c"><mxGeometry x="820" y="42" width="244" height="126" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Ground truth files&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Planted facts (dev and test split), document index, conflicts. Isolated&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="g_c"><mxGeometry x="1088" y="42" width="244" height="126" as="geometry"/></mxCell>
<mxCell id="_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e23" value="labels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="446" y="722"/><mxPoint x="1250" y="722"/></Array></mxGeometry></mxCell>
<mxCell id="_e24" value="residents loaded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_a" target="g_b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_b" target="g_c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n1" value="&lt;b&gt;Scale&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275&quot;&gt;Demo dataset: 200,000 residents. Storage profiles keep full detail for the first 100,000 residents and lean rule data after that.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="440" height="78" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Reproducible&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275&quot;&gt;Fixed seeds, resumable batches, a manifest of counts and hashes per batch. A completed batch is never redone.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="760" width="440" height="78" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;Boundary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275&quot;&gt;Every row carries a synthetic status. Planted labels never enter the database, a prompt or the document store.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="760" width="440" height="78" as="geometry"/></mxCell>
<mxCell id="_e26" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="950" y="851" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e27" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="970" y="848" width="113" height="18" as="geometry"/></mxCell>
