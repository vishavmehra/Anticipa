<mxCell id="_e23" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1049" y="788" width="113" height="18" as="geometry"/></mxCell>
