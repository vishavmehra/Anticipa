<mxCell id="c1" value="eligible" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="20" y="404" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="cl1" value="Class: eligible" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="236" y="404" width="230" height="26" as="geometry"/></mxCell>
<mxCell id="c20" value="not eligible" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="20" y="440" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="c21" value="already completed" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="20" y="474" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="c22" value="temporarily excluded" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="20" y="508" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="cl2" value="Class: ineligible" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="236" y="462" width="230" height="26" as="geometry"/></mxCell>
<mxCell id="c30" value="insufficient evidence" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="20" y="546" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="c31" value="requires clinical review" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="20" y="580" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="cl3" value="Class: indeterminate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="236" y="556" width="230" height="26" as="geometry"/></mxCell>
<mxCell id="c4" value="evaluation error" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="236" y="592" width="210" height="26" as="geometry"/></mxCell>
<mxCell id="cl4" value="Class: error" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_eval"><mxGeometry x="236" y="618" width="230" height="20" as="geometry"/></mxCell>
<mxCell id="g_res" value="RESULTS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="112" width="390" height="650" as="geometry"/></mxCell>
<mxCell id="r0" value="&lt;b&gt;eligibility_evaluations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Outcome, explanation, guideline and rule version, engine version, evaluation time&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_res"><mxGeometry x="20" y="40" width="350" height="84" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;Care gap case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Opened for eligible residents and for cases that need clinical review. Priority is deterministic&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_res"><mxGeometry x="20" y="150" width="350" height="84" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Incremental re-run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Only residents whose inputs changed are evaluated again, for example after new facts&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_res"><mxGeometry x="20" y="260" width="350" height="84" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;Safety design&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;&amp;bull; AI evidence enters only as quote verified facts and only through rules.&lt;br&gt;&amp;bull; Approval status and clinical review status are tracked separately.&lt;br&gt;&amp;bull; Rule limits: depth 8, 64 leaves, 80 rules per version.&lt;br&gt;&amp;bull; A rule regression suite replays test cases through the engine with no database and no model.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="486" width="350" height="250" as="geometry"/></mxCell>
