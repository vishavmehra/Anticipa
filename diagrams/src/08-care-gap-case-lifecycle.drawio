<mxCell id="onote" value="identified can go straight to approved_for_planning. Planned cases can return to awaiting_capacity. Outreach can restart from appointment_scheduled. Every change is validated and written to the case history." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_open"><mxGeometry x="460" y="322" width="880" height="50" as="geometry"/></mxCell>
<mxCell id="g_end" value="TERMINAL AND SIDE STATUSES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1360" height="140" as="geometry"/></mxCell>
<mxCell id="completed" value="&lt;b&gt;completed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Verified evidence and a different reviewer&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_end"><mxGeometry x="300" y="40" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="closed" value="&lt;b&gt;closed_not_completed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Authorised exception with a reason&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_end"><mxGeometry x="570" y="40" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="cancelled" value="&lt;b&gt;cancelled&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Reason required&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_end"><mxGeometry x="840" y="40" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="escalated" value="&lt;b&gt;escalated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Handed to a clinician or administrator&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_end"><mxGeometry x="1110" y="40" width="200" height="70" as="geometry"/></mxCell>
<mxCell id="_e19" value="verified completion evidence only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#2E8B57;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="completed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_open" target="closed"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="520"/><mxPoint x="710" y="560"/></Array></mxGeometry></mxCell>
<mxCell id="_e21" value="any open status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_open" target="cancelled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e22" value="any open status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.82;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_open" target="escalated"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e23" value="reopen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_end" target="o1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="22" y="610"/><mxPoint x="22" y="140"/><mxPoint x="440" y="140"/></Array></mxGeometry></mxCell>
<mxCell id="prio" value="&lt;b&gt;Deterministic priority (rules caregaps.priority/1, first match wins)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;1. Hereditary or family history pathway (BRCA, colorectal family history): high&lt;br&gt;2. Outcome is requires_clinical_review: high&lt;br&gt;3. Eligible, but sources conflict: elevated&lt;br&gt;4. Everything else: routine&lt;br&gt;&lt;br&gt;A priority set on a guideline version is a floor and is never lowered. Priority orders the work. It never changes eligibility, and no model is involved.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="640" height="170" as="geometry"/></mxCell>
<mxCell id="perm" value="&lt;b&gt;Rules of the machine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;&amp;bull; Only caregaps.service changes status. Other modules call it and never edit status.&lt;br&gt;&amp;bull; A reason is required for escalated, cancelled and closed_not_completed.&lt;br&gt;&amp;bull; completed is reachable only through closure with verified completion evidence.&lt;br&gt;&amp;bull; Terminal cases can only be reopened, into pending_review.&lt;br&gt;&amp;bull; Permissions: caregaps.manage, caregaps.review and caregaps.close, depending on the change.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="708" width="700" height="170" as="geometry"/></mxCell>
<mxCell id="_e24" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="883" y="891" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e25" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="903" y="888" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e26" value="" style="rounded=1;arcSize=25;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1018" y="891" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e27" value="Human review" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1038" y="888" width="79" height="18" as="geometry"/></mxCell>
