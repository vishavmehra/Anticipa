<mxCell id="_e29" value="Verified or complete" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1139" y="888" width="124" height="18" as="geometry"/></mxCell>
<mxCell id="_e30" value="" style="rounded=1;arcSize=25;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1265" y="891" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e31" value="Blocked or refused" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1285" y="888" width="113" height="18" as="geometry"/></mxCell>
</root>
