<mxfile host="app.diagrams.net" agent="Anticipa diagrams" version="24.0.0">
<diagram id="09-capacity-planning" name="Capacity planning">
<mxGraphModel dx="1440" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1440" height="860" as="geometry"/></mxCell>
<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Capacity planning&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="OR-Tools CP-SAT assigns open cases to simulated clinic slots. Priority and equity are in the objective. Consent and capacity are hard rules." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_in" value="INPUTS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="330" height="600" as="geometry"/></mxCell>
<mxCell id="i0" value="&lt;b&gt;Open cases&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Approved for planning. Grouped by service, district, priority and language&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_in"><mxGeometry x="20" y="40" width="290" height="108" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;Clinic capacity (simulated)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Clinics, services and slots inside the planning horizon. District travel tiers&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_in"><mxGeometry x="20" y="176" width="290" height="108" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;b&gt;Consent state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Residents with every outreach channel denied are left out&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_in"><mxGeometry x="20" y="312" width="290" height="108" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;b&gt;Plan settings&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Priority weights, travel penalty, equity weight 0.2 on district and language, fixed seed&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_in"><mxGeometry x="20" y="448" width="290" height="108" as="geometry"/></mxCell>
<mxCell id="g_plan" value="PLANNER" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="410" y="112" width="620" height="600" as="geometry"/></mxCell>
<mxCell id="p0" value="&lt;b&gt;Pre-filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Invalid case data and consent denied cases become unallocated with a reason. They never get a seat&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_plan"><mxGeometry x="30" y="40" width="560" height="84" as="geometry"/></mxCell>
<mxCell id="p0_n" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="g_plan"><mxGeometry x="21" y="31" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;Stage 1: CP-SAT over groups&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Maximise priority weighted coverage minus travel penalty, plus a maximin equity term for district and language. Model size depends on groups and pools, not case count&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_plan"><mxGeometry x="30" y="144" width="560" height="104" as="geometry"/></mxCell>
<mxCell id="p1_n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="g_plan"><mxGeometry x="21" y="135" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;Stage 2: place cases in slots&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Per pool, order by priority, opened date and case id. Earliest free slot with no clash for the same resident. A final sweep fills leftover seats&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_plan"><mxGeometry x="30" y="268" width="560" height="92" as="geometry"/></mxCell>
<mxCell id="p2_n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="g_plan"><mxGeometry x="21" y="259" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;Plan validator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Re-checks eleven hard constraints on the finished plan before it is stored&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_plan"><mxGeometry x="30" y="380" width="560" height="64" as="geometry"/></mxCell>
<mxCell id="p3_n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="g_plan"><mxGeometry x="21" y="371" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0" target="p1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cons" value="&lt;b&gt;Hard constraints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Each case at most once. Slot capacity. Service match. Slot availability and duration. Planning horizon. Travel tier limit. No clash in time for one resident. Case in scope. Consent respected.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="440" y="580" width="560" height="120" as="geometry"/></mxCell>
<mxCell id="g_out" value="OUTPUTS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1070" y="112" width="330" height="600" as="geometry"/></mxCell>
<mxCell id="o0" value="&lt;b&gt;Allocations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Case to slot, with coverage, equity gaps and solver status&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="20" y="40" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;Unallocated with a reason&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;For example consent_denied, invalid_case_data, resident_time_conflict or capacity used up&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="20" y="164" width="290" height="110" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;Reproducible&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Fixed seed, a single worker, a recorded time limit and gap, and a hash of the input snapshot.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="410" width="290" height="140" as="geometry"/></mxCell>
<mxCell id="o3" value="&lt;b&gt;Compared with a baseline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Evaluation replays the same cases and capacity with first come first served: nearest clinic, earliest free slot.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="566" width="290" height="130" as="geometry"/></mxCell>
<mxCell id="_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4B2FC4;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_in" target="g_plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4B2FC4;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_plan" target="g_out"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="foot" value="All capacity is simulated. Reported numbers describe synthetic residents and simulated clinics, not any real health system." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1360" height="40" as="geometry"/></mxCell>
<mxCell id="_e16" value="" style="rounded=1;arcSize=25;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1074" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e17" value="Data store" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1094" y="828" width="68" height="18" as="geometry"/></mxCell>
<mxCell id="_e18" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1164" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e19" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1184" y="828" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e20" value="" style="rounded=1;arcSize=25;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1299" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e21" value="Human review" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1319" y="828" width="79" height="18" as="geometry"/></mxCell>
</root>
