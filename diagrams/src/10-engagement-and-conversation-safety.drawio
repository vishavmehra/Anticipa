<mxCell id="_e36" value="Verified or complete" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1274" y="808" width="124" height="18" as="geometry"/></mxCell>
