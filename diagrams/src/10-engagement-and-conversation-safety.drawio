<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Engagement and resident conversation safety&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Approved templates reach residents first. If a resident replies, deterministic safety layers run before and after the model. Everything is simulated." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_out" value="OUTREACH (ENGAGEMENT MODULE)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="1360" height="150" as="geometry"/></mxCell>
<mxCell id="o0" value="&lt;b&gt;Planned case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;A slot is allocated&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="16" y="40" width="196" height="96" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;Consent check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Channel must be permitted. Denied: 409, audited, nothing sent&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="238" y="40" width="196" height="96" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;Approved template&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;English, Hindi or Arabic. No AI by default&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="460" y="40" width="196" height="96" as="geometry"/></mxCell>
<mxCell id="o3" value="&lt;b&gt;Simulated message&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;SMS, WhatsApp, phone call or email. Nobody is contacted&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="682" y="40" width="196" height="96" as="geometry"/></mxCell>
<mxCell id="o4" value="&lt;b&gt;Delivery state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Queued, sent, delivered or failed&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="904" y="40" width="196" height="96" as="geometry"/></mxCell>
<mxCell id="o5" value="&lt;b&gt;Resident response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Accept, decline, question or no response. A question escalates to a clinician&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_out"><mxGeometry x="1126" y="40" width="196" height="96" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o0" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o3" target="o4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="o4" target="o5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g_conv" value="RESIDENT CONVERSATION (CONVERSATION MODULE)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=330;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1360" height="360" as="geometry"/></mxCell>
<mxCell id="m0" value="&lt;b&gt;Resident message&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Typed in the simulation, up to 600 characters&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="16" y="110" width="170" height="100" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;Consent check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;A denied channel withholds the reply. A health hand off still escalates&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="212" y="110" width="210" height="100" as="geometry"/></mxCell>
<mxCell id="m2" value="&lt;b&gt;Deterministic classifier&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275;font-weight:normal&quot;&gt;Keyword lists in three languages, before any model. Emergency, medical, eligibility or record dispute, opt out, prompt injection, then logistics&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="448" y="110" width="290" height="100" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;b&gt;Fixed approved reply&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275;font-weight:normal&quot;&gt;Emergency: urgent care message. Medical or eligibility: clinician hand off. Opt out: recorded. Injection: scope limit&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="780" y="50" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;Logistics via the Model Router&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;engagement.converse, Claude Haiku, JSON step, case facts as untrusted data&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="780" y="190" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;Deterministic reply check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275;font-weight:normal&quot;&gt;No clinical language, no booking claim, numbers from case facts, right script, no links, 700 characters&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="1070" y="190" width="274" height="100" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Reply stored&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Labelled simulated. Escalation goes through the one case lifecycle&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="1070" y="50" width="274" height="112" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;Could not prepare a reply&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275;font-weight:normal&quot;&gt;Approved fallback text&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_conv"><mxGeometry x="1070" y="306" width="274" height="46" as="geometry"/></mxCell>
<mxCell id="_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m0" target="m1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e19" value="logistics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="m2" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6D4AFF;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e21" value="passes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#2E8B57;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e23" value="fails twice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#C23B5A;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e24" value="reply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="o5" target="m0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1264" y="272"/><mxPoint x="141" y="272"/></Array></mxGeometry></mxCell>
<mxCell id="n1" value="&lt;b&gt;Emergency override&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Consent governs outreach, not a safety reply. If the resident starts a message with emergency language, the approved urgent care reply is sent even when the channel is denied. The case still escalates and the block is audited.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="440" height="120" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Limits and cost control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;60 messages per user per hour, 50 resident messages per case and a daily budget for the task. Over a cap the model is skipped and the approved texts still answer. A provider outage never produces an invented answer.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="680" width="440" height="120" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;Evaluated&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Red team set of 71 messages in English, Hindi and Arabic: escalation recall 40 of 40, emergencies given the urgent message 11 of 11, no clinical advice or invented facts found by an independent judge.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="680" width="440" height="120" as="geometry"/></mxCell>
<mxCell id="_e25" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="709" y="811" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e26" value="Person" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="729" y="808" width="46" height="18" as="geometry"/></mxCell>
<mxCell id="_e27" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="776" y="811" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e28" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="796" y="808" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e29" value="" style="rounded=1;arcSize=25;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="911" y="811" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e30" value="Blocked or refused" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="931" y="808" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e31" value="" style="rounded=1;arcSize=25;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1046" y="811" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e32" value="Human review" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1066" y="808" width="79" height="18" as="geometry"/></mxCell>
<mxCell id="_e33" value="" style="rounded=1;arcSize=25;fillColor=#EFEAFF;strokeColor=#6D4AFF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1147" y="811" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e34" value="AI model call" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1167" y="808" width="85" height="18" as="geometry"/></mxCell>
