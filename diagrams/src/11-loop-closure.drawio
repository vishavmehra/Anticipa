<mxfile host="app.diagrams.net" agent="Anticipa diagrams" version="24.0.0">
<diagram id="11-loop-closure" name="Loop closure with verified completion evidence">
<mxGraphModel dx="1440" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="720" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1440" height="720" as="geometry"/></mxCell>
<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Loop closure with verified completion evidence&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="A message, a reply or an appointment never closes a case. Only evidence that care happened, verified by a second person, does." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="a" value="&lt;b&gt;Appointment completed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Appointment status moves proposed, simulated_confirmed, completed, no_show or cancelled. It never completes the case by itself&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="230" height="112" as="geometry"/></mxCell>
<mxCell id="a_n" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="31" y="159" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="b" value="&lt;b&gt;Submit completion evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Source: simulated procedure record, clinical record, document or manual attestation. It starts as pending&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="297" y="168" width="230" height="112" as="geometry"/></mxCell>
<mxCell id="b_n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="288" y="159" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="c" value="&lt;b&gt;Reference check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;A cited record or document must exist and belong to the same resident. Nothing is inferred&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="554" y="168" width="230" height="112" as="geometry"/></mxCell>
<mxCell id="c_n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="545" y="159" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="d" value="&lt;b&gt;Second person review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Needs caregaps.review or caregaps.close, and a person other than the submitter&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="811" y="168" width="230" height="112" as="geometry"/></mxCell>
<mxCell id="d_n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="802" y="159" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="rej" value="&lt;b&gt;Rejected&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Evidence stays on record. Submit new evidence or use an exception&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1148" y="120" width="250" height="84" as="geometry"/></mxCell>
<mxCell id="ver" value="&lt;b&gt;Verified&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Evidence can now support closure&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1148" y="244" width="250" height="84" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e14" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#C23B5A;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d" target="rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e15" value="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#2E8B57;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d" target="ver"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cl" value="&lt;b&gt;close_case: completed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Needs verified evidence for this case and status awaiting_completion_evidence&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1148" y="420" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="cl_n" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1139" y="411" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="done" value="&lt;b&gt;completed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;The only way to reach completed. Written to the case history and audit log&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="871" y="420" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#2E8B57;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ver" target="cl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#2E8B57;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cl" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ex" value="&lt;b&gt;Close without completion&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;An authorised exception. Needs caregaps.close, an exception type and a reason&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="594" y="420" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="ex_n" value="A" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="411" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="cnc" value="&lt;b&gt;closed_not_completed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Recorded in the case history and audit log with the reason&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="317" y="420" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#C23B5A;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ex" target="cnc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="alt" value="Alternative path for cases that cannot be completed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="260" height="70" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;Never counted as evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Messages, resident responses and appointments. Closure looks only at evidence rows that a different person verified.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="440" height="90" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Simulation evidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;The simulation job is a system actor. Its simulated procedure records are verified on arrival and labelled simulated.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="500" y="580" width="440" height="90" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;Reopening&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;A completed, closed or cancelled case can be reopened into pending_review with a reason. History is kept.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="440" height="90" as="geometry"/></mxCell>
<mxCell id="_e19" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="883" y="691" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e20" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="903" y="688" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e21" value="" style="rounded=1;arcSize=25;fillColor=#FFF3DB;strokeColor=#C98A12;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1018" y="691" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e22" value="Human review" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1038" y="688" width="79" height="18" as="geometry"/></mxCell>
<mxCell id="_e23" value="" style="rounded=1;arcSize=25;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1119" y="691" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e24" value="Verified or complete" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1139" y="688" width="124" height="18" as="geometry"/></mxCell>
<mxCell id="_e25" value="" style="rounded=1;arcSize=25;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1265" y="691" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e26" value="Blocked or refused" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1285" y="688" width="113" height="18" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
