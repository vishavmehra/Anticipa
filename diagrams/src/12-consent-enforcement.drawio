<mxfile host="app.diagrams.net" agent="Anticipa diagrams" version="24.0.0">
<diagram id="12-consent-enforcement" name="Consent and opt-out enforcement points">
<mxGraphModel dx="1440" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1440" height="860" as="geometry"/></mxCell>
<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Consent and opt-out enforcement points&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="One append only ledger, checked at every place that could contact a resident or process their documents with AI. Guards fail closed." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_w" value="WHO WRITES A DECISION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="330" height="470" as="geometry"/></mxCell>
<mxCell id="w0" value="&lt;b&gt;Coordinator or administrator&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;POST consents needs consent.manage. Validated and audited as consent.record&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="20" y="40" width="290" height="110" as="geometry"/></mxCell>
<mxCell id="w1" value="&lt;b&gt;Resident opt out in conversation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Opt out intent records a blanket outreach deny with source resident_request&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="20" y="170" width="290" height="110" as="geometry"/></mxCell>
<mxCell id="w2" value="&lt;b&gt;Synthetic seed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Seed deterministic set for the demo, removable. Never removes a person's decision&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="g_w"><mxGeometry x="20" y="300" width="290" height="110" as="geometry"/></mxCell>
<mxCell id="ledger" value="&lt;b&gt;Consent ledger (consent_records)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Append only. Scopes: outreach, data_use_ai_processing. Status permit or deny. Optional channel: sms, whatsapp, phone call, email&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="230" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="sem" value="&lt;b&gt;How a decision is read&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;&amp;bull; In force: the newest record currently effective for each scope and channel.&lt;br&gt;&amp;bull; Deny wins across the blanket and channel levels.&lt;br&gt;&amp;bull; No record means permit, as synthetic data on the resident's own record.&lt;br&gt;&amp;bull; A decision is never edited. Withdrawing is recording the opposite status.&lt;br&gt;&amp;bull; A resident is unreachable only when every channel is denied.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="410" width="440" height="170" as="geometry"/></mxCell>
<mxCell id="fhir" value="&lt;b&gt;Read API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;GET consents returns what is in force, the history and a FHIR R4 Consent shape per record.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="470" y="112" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="g_e" value="WHERE IT IS ENFORCED" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1010" y="112" width="390" height="650" as="geometry"/></mxCell>
<mxCell id="e0" value="&lt;b&gt;Planning&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Every channel denied: the case is unallocated as consent_denied. consent_respected is a hard constraint of every plan&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_e"><mxGeometry x="20" y="40" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e1" value="&lt;b&gt;Engagement events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;A denied channel returns 409 CONFLICT. Only a blocked audit event is written&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_e"><mxGeometry x="20" y="140" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e2" value="&lt;b&gt;Engagement drafts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Only permitted channels are offered. Blocked channels are listed&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_e"><mxGeometry x="20" y="240" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e3" value="&lt;b&gt;Simulation job&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;A resident with no usable channel is skipped. Otherwise the first permitted channel is used&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_e"><mxGeometry x="20" y="340" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e4" value="&lt;b&gt;Evidence extraction and embedding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Documents of residents who denied AI processing are skipped, not deleted&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_e"><mxGeometry x="20" y="440" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="e5" value="&lt;b&gt;Conversation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Reply withheld on a denied channel. Health hand offs still escalate. An emergency message still gets the urgent reply&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_e"><mxGeometry x="20" y="540" width="350" height="88" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4B2FC4;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_w" target="ledger"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4B2FC4;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ledger" target="g_e"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="aud" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Blocks and skips write consent.outreach.blocked and consent.ai_processing.skipped events. The free text note is kept out of the audit trail.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="940" height="100" as="geometry"/></mxCell>
<mxCell id="_e13" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="849" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e14" value="Person" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="869" y="828" width="46" height="18" as="geometry"/></mxCell>
<mxCell id="_e15" value="" style="rounded=1;arcSize=25;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="917" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e16" value="External service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="937" y="828" width="102" height="18" as="geometry"/></mxCell>
<mxCell id="_e17" value="" style="rounded=1;arcSize=25;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1040" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e18" value="Data store" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1060" y="828" width="68" height="18" as="geometry"/></mxCell>
<mxCell id="_e19" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1130" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e20" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1150" y="828" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e21" value="" style="rounded=1;arcSize=25;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1265" y="831" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e22" value="Blocked or refused" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="1285" y="828" width="113" height="18" as="geometry"/></mxCell>
