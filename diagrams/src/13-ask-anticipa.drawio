<diagram id="13-ask-anticipa" name="Ask Anticipa: a grounded loop over aggregates">
<mxGraphModel dx="1440" dy="790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="790" math="0" shadow="0" background="#FFFFFF">
