<mxCell id="tool4" value="get_care_gap_breakdown" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="1080" y="46" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tool5" value="get_closure_trend" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="16" y="90" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tool6" value="get_capacity_overview" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="282" y="90" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tool7" value="get_engagement_overview" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="548" y="90" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tool8" value="get_evaluation_summary" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="814" y="90" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tn" value="Groups of fewer than 5 cases are suppressed. No tool returns a resident, document or fact." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="1080" y="90" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="_e15" value="tool calls and results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6D4AFF;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;startSize=5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="g_t"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r0" value="&lt;b&gt;Grounding check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Every number must be a tool value, a rounding or percentage of one, a difference of two values of one field, or a number the user wrote. One correction retry&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="871" y="490" width="250" height="126" as="geometry"/></mxCell>
<mxCell id="r0_n" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="481" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;Chart and table by the server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Built from tool results. The model only names the source call and fields&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="594" y="490" width="250" height="126" as="geometry"/></mxCell>
<mxCell id="r1_n" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="481" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Answer returned&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Answer, chart, table, sources, follow ups, grounded, refused, cost and latency. Unverified figures are flagged&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F6EC;strokeColor=#2E8B57;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="317" y="490" width="250" height="126" as="geometry"/></mxCell>
<mxCell id="r2_n" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="308" y="481" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;Audit event ask.query&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Question hash, tools used, tokens, cost, grounded, refused. No question text&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="250" height="126" as="geometry"/></mxCell>
<mxCell id="r3_n" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="31" y="481" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_t" target="r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="n1" value="&lt;b&gt;Same figures everywhere&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Breakdowns come from the same analytics snapshot as the Command Center and the map.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1148" y="490" width="250" height="126" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Measured on 25 golden questions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;20 answerable, 5 must refuse: accuracy 20 of 20, grounded 25 of 25, refusals 5 of 5, p50 latency 2.9 s. About $0.00028 per question (prompt cache hits).&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="660" height="76" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;Boundaries&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Read only and synthetic data only. It never decides eligibility or gives clinical advice.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="680" height="76" as="geometry"/></mxCell>
