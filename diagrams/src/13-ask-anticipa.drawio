<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Ask Anticipa: a grounded loop over aggregates&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Natural language questions about the population. Read only tools, numbers checked in code, charts built by the server. No resident level data." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Up to 500 characters, 6 history turns, optional district or programme. Needs analytics.view&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="s0_n" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="31" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;Pre-filter in code&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Refuses resident ids and individual or clinical requests without any model call&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="317" y="130" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="s1_n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="308" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;Limits and cache&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;20 per hour and 200 per day per user, a task daily budget, a 10 minute response cache&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="594" y="130" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="s2_n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="585" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;Model Router: ask.analytics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Claude Haiku, effort low. A JSON step: call_tools, answer or refuse. At most 4 model calls&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EFEAFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="871" y="130" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="s3_n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;Refusals&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Clinical advice, individual eligibility or diagnosis, identifiable residents, anything outside the data&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1148" y="130" width="250" height="112" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#C23B5A;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g_t" value="NINE READ ONLY TOOLS (UP TO 3 ROUNDS, 3 CALLS PER ROUND, ARGUMENTS VALIDATED, NO FREE SQL)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="1360" height="150" as="geometry"/></mxCell>
<mxCell id="tool0" value="get_overview_kpis" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="16" y="46" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tool1" value="get_funnel" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="282" y="46" width="250" height="34" as="geometry"/></mxCell>
<mxCell id="tool2" value="get_geography" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="g_t"><mxGeometry x="548" y="46" width="250" height="34" as="geometry"/></mxCell>
