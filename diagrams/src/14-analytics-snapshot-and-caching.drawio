<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Analytics snapshot and caching&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Heavy aggregates are computed once and served from one row. Pages revalidate in the background instead of waiting." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_w" value="WRITE SIDE: KEEPING THE SNAPSHOT FRESH" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="1360" height="250" as="geometry"/></mxCell>
<mxCell id="t0" value="&lt;b&gt;Worker finishes an analytics relevant job&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="16" y="40" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="t1" value="&lt;b&gt;CLI: python -m anticipa.analytics refresh&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="16" y="104" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="t2" value="&lt;b&gt;API notices changed table counters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Fingerprint of watched tables differs&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="16" y="168" width="340" height="54" as="geometry"/></mxCell>
<mxCell id="compute" value="&lt;b&gt;compute_core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Heavy aggregate queries run once: counts by district, programme, status and priority, stage counts, closure trend. A few seconds at 200,000 residents&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="430" y="52" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="snap" value="&lt;b&gt;analytics_snapshots row&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;One JSON row (migration 0008). Every dashboard endpoint is shaped from it&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_w"><mxGeometry x="800" y="52" width="300" height="130" as="geometry"/></mxCell>
<mxCell id="wn" value="A GET never waits for a refresh. If data changed it starts one background refresh per process." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="g_w"><mxGeometry x="1120" y="52" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t0" target="compute"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t1" target="compute"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="compute"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="compute" target="snap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g_r" value="READ SIDE: SERVING IN MILLISECONDS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="1360" height="260" as="geometry"/></mxCell>
<mxCell id="r0" value="&lt;b&gt;GET analytics endpoints&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Command Center, funnel, geography, programmes, capacity, engagement, and the Ask tools&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="16" y="50" width="244" height="120" as="geometry"/></mxCell>
<mxCell id="r1" value="&lt;b&gt;Read one snapshot row&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Milliseconds. No heavy query on the request path&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="288" y="50" width="244" height="120" as="geometry"/></mxCell>
<mxCell id="r2" value="&lt;b&gt;Shape the response&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Every endpoint is cut from the same row, so the map, KPIs and Ask Anticipa agree&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="560" y="50" width="244" height="120" as="geometry"/></mxCell>
<mxCell id="r3" value="&lt;b&gt;ETag and Cache-Control&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Weak hash of the figures. private, max-age=30, stale-while-revalidate=120, Vary Authorization&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="832" y="50" width="244" height="120" as="geometry"/></mxCell>
<mxCell id="r4" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;If-None-Match gets a 304 with no body. The useApi hook shows the last answer at once and revalidates&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="1104" y="50" width="244" height="120" as="geometry"/></mxCell>
<mxCell id="_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e19" value="latest row" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="snap" target="r1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="372"/><mxPoint x="450" y="372"/></Array></mxGeometry></mxCell>
<mxCell id="fb" value="&lt;b&gt;No snapshot yet: compute live&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDEBEF;strokeColor=#C23B5A;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;dashed=1;dashPattern=5 3;" vertex="1" parent="g_r"><mxGeometry x="288" y="194" width="244" height="54" as="geometry"/></mxCell>
<mxCell id="_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="fb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="pf" value="&lt;b&gt;Prefetch on link hover&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="1104" y="194" width="244" height="54" as="geometry"/></mxCell>
<mxCell id="_e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.2;strokeColor=#6B7186;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r4" target="pf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="mem" value="&lt;b&gt;In memory cache, up to 300 keys&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_r"><mxGeometry x="832" y="194" width="244" height="54" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;b&gt;Why&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#5B6275&quot;&gt;Counting about 1.2 million evaluations and 116 thousand cases per page view is too slow. One precomputed row keeps every screen fast and consistent.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="1360" height="70" as="geometry"/></mxCell>
<mxCell id="_e22" value="" style="rounded=1;arcSize=25;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="956" y="771" width="16" height="12" as="geometry"/></mxCell>
<mxCell id="_e23" value="Deterministic code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;spacing=2;" vertex="1" parent="1"><mxGeometry x="976" y="768" width="113" height="18" as="geometry"/></mxCell>
<mxCell id="_e24" value="" style="rounded=1;arcSize=25;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1091" y="771" width="16" height="12" as="geometry"/></mxCell>
