<diagram id="14-analytics-snapshot-and-caching" name="Analytics snapshot and caching">
<mxGraphModel dx="1440" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="800" math="0" shadow="0" background="#FFFFFF">
