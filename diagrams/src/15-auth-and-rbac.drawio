<mxCell id="n1" value="&lt;b&gt;The observer role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;Judges. Every product view, nothing internal, no writes, no job submission and no AI triggering actions.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="690" width="480" height="100" as="geometry"/></mxCell>
<mxCell id="n2" value="&lt;b&gt;Enforcement&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275&quot;&gt;The UI hides actions using GET /auth/me. The API enforces every check. Resident reads write a resident.read audit event.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=11;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="920" y="690" width="480" height="100" as="geometry"/></mxCell>
