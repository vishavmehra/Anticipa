<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Authentication and role based access&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Identity comes from Supabase. Authorization is decided by the API from one explicit role to permission map, deny by default." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;b&gt;Sign in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Email and password through Supabase Auth. Google sign-in defaults to the read only observer role&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D4AFF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="212" height="120" as="geometry"/></mxCell>
<mxCell id="s0_n" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="31" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;Supabase issues a JWT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;An ES256 access token&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="269" y="130" width="212" height="120" as="geometry"/></mxCell>
<mxCell id="s1_n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="260" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;Browser calls the API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Authorization: Bearer token only. No cookies to the API, so no CSRF header is needed&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="498" y="130" width="212" height="120" as="geometry"/></mxCell>
<mxCell id="s2_n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="489" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;API verifies the token&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Project JWKS, audience authenticated and issuer checked&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="727" y="130" width="212" height="120" as="geometry"/></mxCell>
<mxCell id="s3_n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="718" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;Role from app_metadata only&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;anticipa_role is written only by the Admin API with the secret key. user_metadata is never trusted&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="956" y="130" width="212" height="120" as="geometry"/></mxCell>
<mxCell id="s4_n" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="947" y="121" width="20" height="20" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;Permission check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;require_permission deny by default. A missing or unknown role gets 403&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1185" y="130" width="212" height="120" as="geometry"/></mxCell>
<mxCell id="s5_n" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=10;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1176" y="121" width="20" height="20" as="geometry"/></mxCell>
