<mxCell id="auth" value="&lt;b&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Issues the JWT. The API verifies it with JWKS&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_cloud"><mxGeometry x="220" y="212" width="190" height="90" as="geometry"/></mxCell>
