<mxfile host="app.diagrams.net" agent="Anticipa diagrams" version="24.0.0">
<diagram id="17-fhir-mapping-and-write-back" name="FHIR mapping and write-back">
<mxGraphModel dx="1440" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="840" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1440" height="840" as="geometry"/></mxCell>
<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;FHIR mapping and write-back&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Synthea resources and Anticipa rows are mapped by pure functions and loaded into a HAPI FHIR R4 server as idempotent transaction bundles." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="g_src" value="SOURCES (READ ONLY)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="420" height="250" as="geometry"/></mxCell>
<mxCell id="s0" value="&lt;b&gt;Synthea resources (NDJSON.gz)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Patient, Condition, Procedure, Observation, Immunization, MedicationRequest, DiagnosticReport, Encounter&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_src"><mxGeometry x="20" y="40" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;Anticipa database rows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Care gap cases, outreach, appointments, consent, clinics, family edges, generated documents&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_src"><mxGeometry x="20" y="146" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="g_load" value="HAPI-LOAD (BACKEND/ANTICIPA/DATAFABRIC)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="500" y="108" width="420" height="250" as="geometry"/></mxCell>
<mxCell id="h0" value="&lt;b&gt;fhir_map: pure functions&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;No I/O. Conditional references become Reference.identifier. References outside the subset are dropped&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_load"><mxGeometry x="20" y="40" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;Transaction bundles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;PUT [type]/[id]. Idempotent and resumable. Failed entries are listed, never skipped silently&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3A4156;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_load"><mxGeometry x="20" y="146" width="380" height="90" as="geometry"/></mxCell>
<mxCell id="hapi" value="&lt;b&gt;HAPI FHIR server (R4)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;Judging subset: about 1,100 residents as whole family blocks, matching the cloud database. Patient ids equal the Synthea ids and carry the Anticipa resident id as an identifier. Every resource is tagged synthetic or simulated&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="980" y="120" width="420" height="226" as="geometry"/></mxCell>
<mxCell id="_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4B2FC4;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_src" target="g_load"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4B2FC4;endArrow=block;endFill=1;endSize=5;fontSize=10;fontColor=#5B6275;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="g_load" target="hapi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="g_map" value="ANTICIPA ROWS BECOME FHIR RESOURCES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="1360" height="330" as="geometry"/></mxCell>
<mxCell id="m0" value="&lt;b&gt;Care gap case&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;DetectedIssue, Task, Flag and Provenance. Provenance says deterministic rules decided, not a diagnosis&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="16" y="44" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;Outreach and replies&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Communication: simulated outreach, resident responses and conversation messages&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="352" y="44" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="m2" value="&lt;b&gt;Appointments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Appointment, from appointments and planned allocations&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="688" y="44" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="m3" value="&lt;b&gt;Consent record&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Consent: status to provision.type, scope to purpose, channel as an extension&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="1024" y="44" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="m4" value="&lt;b&gt;Clinics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;Location&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="16" y="182" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="m5" value="&lt;b&gt;Family edges&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;RelatedPerson&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="352" y="182" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="m6" value="&lt;b&gt;Generated documents&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#5B6275;font-weight:normal&quot;&gt;DocumentReference with the text inline&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="g_map"><mxGeometry x="688" y="182" width="316" height="118" as="geometry"/></mxCell>
<mxCell id="n1" value="&lt;span style=&quot;font-size:9px;color:#5B6275&quot;&gt;Write-back resources carry the case status, care activity and channel as Anticipa coded tags.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1360" height="52" as="geometry"/></mxCell>
