<mxCell id="g_pipe" value="PIPELINE OUTPUT (READ ONLY)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FBFAFF;strokeColor=#D6CFF5;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=11;fontColor=#4B2FC4;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="108" width="360" height="290" as="geometry"/></mxCell>
<mxCell id="p0" value="&lt;b&gt;Evidence facts&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E7F5F2;strokeColor=#1F8F7E;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="g_pipe"><mxGeometry x="20" y="40" width="320" height="64" as="geometry"/></mxCell>
