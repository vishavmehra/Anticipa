<mxfile host="app.diagrams.net" agent="Anticipa diagrams" version="24.0.0">
<diagram id="20-security-layers" name="Security layers">
<mxGraphModel dx="1440" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1440" height="900" as="geometry"/></mxCell>
<mxCell id="bar" value="" style="rounded=1;arcSize=50;fillColor=#6D4AFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="6" height="52" as="geometry"/></mxCell>
<mxCell id="title" value="&lt;b&gt;Security layers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F2430;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="26" width="1320" height="34" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Defence in depth from the browser to the database to the GitHub snapshot. Each layer is enforced in code and does not depend on the one above it." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#5B6275;fontFamily=Helvetica;whiteSpace=wrap;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="62" width="1320" height="22" as="geometry"/></mxCell>
<mxCell id="footer" value="Anticipa  |  prevention autopilot  |  all data is synthetic or simulated" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A90A2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="520" height="18" as="geometry"/></mxCell>
<mxCell id="l0" value="&lt;b&gt;1  Edge&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#4B2FC4;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b0" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;Same origin /api rewrite, so no CORS. Security headers on every API response: nosniff, frame deny, no referrer, HSTS and a strict content policy. A request body size limit. Provider keys and the Supabase secret key never reach the browser.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="108" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w0" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;api/middleware.py, next.config.ts&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="108" width="240" height="92" as="geometry"/></mxCell>
<mxCell id="l1" value="&lt;b&gt;2  Identity&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1F2430;strokeColor=#1F2430;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b1" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;Supabase Auth issues ES256 tokens. The API verifies signature, audience and issuer with the project JWKS. Tokens travel only in the Authorization header. The role comes only from app_metadata, which only the Admin API can write.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="212" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w1" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;core/auth.py&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="212" width="240" height="92" as="geometry"/></mxCell>
<mxCell id="l2" value="&lt;b&gt;3  Authorization&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#4B2FC4;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;Deny by default role to permission map with five roles. The observer is read only, with no jobs, integrations, audit or AI triggering actions. Owning modules narrow scope, for example assigned cases for coordinators.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="316" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w2" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;core/rbac.py&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="316" width="240" height="92" as="geometry"/></mxCell>
<mxCell id="l3" value="&lt;b&gt;4  Data&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1F2430;strokeColor=#1F2430;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b3" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;Tables sit in schema anticipa, which the Supabase Data API does not expose. Row Level Security is on every table and privileges are revoked from anon and authenticated. A schema check makes real patient data impossible. Ground truth never enters Supabase.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="420" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w3" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;alembic migrations&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="420" width="240" height="92" as="geometry"/></mxCell>
<mxCell id="l4" value="&lt;b&gt;5  AI safety&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#4B2FC4;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="524" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b4" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;One Model Router for every call. Document and message text is untrusted data. Models never decide eligibility. Quote, reply and grounding checks are deterministic. Budgets and rate limits cap spend. Prompt text is never logged.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="524" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w4" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;ai, evidence, conversation, ask&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="524" width="240" height="92" as="geometry"/></mxCell>
<mxCell id="l5" value="&lt;b&gt;6  Audit&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1F2430;strokeColor=#1F2430;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b5" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;Append only audit events, with a database trigger that rejects UPDATE and DELETE. Resident reads, blocked outreach, consent decisions, approvals and AI queries are recorded. Question and message text is hashed, never stored.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="628" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w5" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;core/audit.py&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="628" width="240" height="92" as="geometry"/></mxCell>
<mxCell id="l6" value="&lt;b&gt;7  Secrets and publishing&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#6D4AFF;strokeColor=#4B2FC4;strokeWidth=1.2;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="732" width="230" height="92" as="geometry"/></mxCell>
<mxCell id="b6" value="&lt;span style=&quot;font-size:13px;color:#5B6275&quot;&gt;The .env file stays local and gitignored. The publish script blocks documentation, env files and key shaped strings, and pushes a code only snapshot to GitHub.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1EDFF;strokeColor=#B9A8FF;strokeWidth=1;fontColor=#1F2430;fontSize=14;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=8;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="732" width="850" height="92" as="geometry"/></mxCell>
<mxCell id="w6" value="&lt;b&gt;Enforced in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5B6275;font-weight:normal&quot;&gt;scripts/publish.ps1&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F3F4F7;strokeColor=#8A90A2;strokeWidth=1.2;fontColor=#1F2430;fontSize=12;fontFamily=Helvetica;verticalAlign=middle;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="1160" y="732" width="240" height="92" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>
