# Copy to .env.local. Only public values belong here: NEVER a Supabase service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
# Destination of the /api/* rewrite (FastAPI). Vercel: set to the Render service URL.
ANTICIPA_API_ORIGIN=http://localhost:8000
